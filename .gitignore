# =============================================================================
#  仓库纪律：只入「配置 / 脚本 / 轻量后处理代码 / 文档」
#  不入：网格(polyMesh)、算例结果(时间目录)、并行分区、后处理数据、日志、缓存
#  依据：网格 2.4 GB、caseCHT_qishi 单算例即 1.5 GB，全量入库会直接撑爆仓库
# =============================================================================

# ---------- 1. 缓存 / 字节码 / 临时 ----------
__pycache__/
*.py[cod]
*.npy
*.bak
*.orig
*.tmp
_trash_*/
_trash*/
_archive*/
.vscode/

# ---------- 2. 日志 / 一次性命令 / 后台输出 ----------
log.*
log
log.*
_cmd_*.txt
_nohup_*.out
*.out

# ---------- 3. 网格（任何位置都不入库；可由 .cas.h5 + 转换器重建）----------
polyMesh/
polyMesh.gz/
# Fluent 源网格同样不入（每个 cas.h5 数百 MB）
*.cas.h5
*.dat.h5
*.msh

# ---------- 4. 并行分区 / 后处理 / 可视化产物 ----------
processor[0-9]*/
processor[0-9]*/
postProcessing/
postProcessing_prev/
VTK/
vtk/
*.vtk
*.vtu
*.foam
*.openfoam

# ---------- 5. 算例时间目录（稳态外迭代检查点 / 瞬态时刻，均为产物）----------
# 只保留 0/ 作为边界条件配置；其余时间目录全部排除
case*/[1-9]*/
case*/[0-9]e-[0-9]*/
case*/0.[0-9]*/
caseCHT*/[1-9]*/
caseCHT*/[0-9]e-[0-9]*/
caseCHT*/0.[0-9]*/
tests/**/[1-9]*/
tests/**/[0-9]e-[0-9]*/
tests/**/0.[0-9]*/
tests/**/constant/
tests/**/postProcessing/

# ---------- 6. 派生数据（可由脚本重建，非配置）----------
*.csv
*.npz
*.png
*.jpg

# ---------- 7. 大体积源数据目录（Fluent 工程，不属本仓库）----------
QiShi_*/
Qishi_*/
routeA_runs/

# ---------- 8. 审计/指标脚本的一次性输出（可重生成）----------
_*.json
_*.tmp
_*.txt
