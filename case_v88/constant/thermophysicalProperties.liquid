FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


thermoType
{
    type            heRhoThermo;
    mixture         multiComponentMixture;
    transport       const;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

species
(
    air
    H2O
);

inertSpecie H2O;

"(mixture|H2O)"
{
    specie
    {
        molWeight   18.0153;
    }
    equationOfState
    {
        rho         998.2;
    }
    thermodynamics
    {
        Cv          4182;
        Hf          -1.5879e+07;
    }
    transport
    {
        mu          1.003e-3;
        Pr          7.0;
    }
}

air
{
    specie
    {
        molWeight   28.9596;
    }
    equationOfState
    {
        rho         998.2;
    }
    thermodynamics
    {
        Cv          724.8;
        Hf          0;
    }
    transport
    {
        mu          1.003e-3;
        Pr          7.0;
    }
}

