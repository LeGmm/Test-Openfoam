FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

// 入口质量流量 2e-5 kg/s ÷ (ρ·A) = 2e-5/(1.1455×1.13e-4) ≈ 0.1545 m/s，流向 -Y
internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           uniform (0 -0.1545 0);
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }





    interface
    {
        type            noSlip;
    }
    wall
    {
        type            noSlip;
    }
}

