FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaces_flow;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 流场切片：仅 fluid 区域有 U / p_rgh，不要对 solid 跑这个
//   postProcess -region fluid -func surfaces_flow -latestTime
// 出图：python tools/plot_z0_slice.py <t>/T_z0.vtk <t>/U_z0.vtk out.png

type            surfaces;
libs            ("libsampling.so");
writeControl    writeTime;
surfaceFormat   vtk;
interpolationScheme cellPoint;
fields          (T U p_rgh);

surfaces
(
    z0
    {
        type            cuttingPlane;
        planeType       pointAndNormal;
        pointAndNormalDict
        {
            point       (0 0 0);
            normal      (0 0 1);
        }
        interpolate     true;
    }
);

// ************************************************************************* //
