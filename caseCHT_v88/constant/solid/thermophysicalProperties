FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/solid";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    // Aluminium（Fluent 源实测：ρ=2719, cp=871, k=202.4）
    specie
    {
        molWeight       27;
    }
    equationOfState
    {
        rho             2719;
    }
    thermodynamics
    {
        Cv              871;
        Hf              0;
    }
    transport
    {
        kappa           202.4;
    }
}

