FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 300;

boundaryField
{
    cyclic
    {
        type            cyclic;
    }
    cyclicAMI
    {
        type            cyclicAMI;
    }
    cyclicACMI
    {
        type            cyclicACMI;
        value           uniform 300;
    }
    cyclicSlip
    {
        type            cyclicSlip;
    }
    conformalCoupled
    {
        type            conformalCoupled;
    }
    empty
    {
        type            empty;
    }
    cyclicRepeatAMI
    {
        type            cyclicRepeatAMI;
    }
    processor
    {
        type            processor;
        value           uniform 300;
    }
    processorCyclic
    {
        type            processorCyclic;
        value           uniform 300;
    }
    symmetryPlane
    {
        type            symmetryPlane;
    }
    symmetry
    {
        type            symmetry;
    }
    wedge
    {
        type            wedge;
    }
    fluidInlet
    {
        type            fixedValue;
        value           uniform 300;
    }
    fluidOutlet
    {
        type            inletOutlet;
        value           uniform 300;
        inletValue      uniform 300;
    }
    fluid_to_metal
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        value           uniform 300;
        Tnbr            T;
    }
}


