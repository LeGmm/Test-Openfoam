FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 结构对比实验：与 v8_1 保持同口径，8 进程 scotch 分区
numberOfSubdomains 8;

method          scotch;

// scotch 不支持时改用下面两行（注释掉上面的 method）
// method        hierarchical;
// coeffs        { n (4 2 1); delta 0.001; }

distributed     no;

roots           ();

